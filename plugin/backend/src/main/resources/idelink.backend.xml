<idea-plugin>
  <dependencies>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.kernel.backend"/>
    <module name="intellij.platform.rpc.topics"/>
    <module name="idelink.shared"/>
  </dependencies>
  <extensionPoints>
    <extensionPoint qualifiedName="io.github.danisec2601.idelink.languageAnalysis"
                    interface="io.github.danisec2601.idelink.LanguageAnalysis" dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.github.danisec2601.idelink.IdelinkStartup"/>
    <platform.rpc.backend.remoteApiProvider implementation="io.github.danisec2601.idelink.IdelinkRpcApiProvider"/>
    <notificationGroup id="idelink" displayType="STICKY_BALLOON"/>
  </extensions>
</idea-plugin>
